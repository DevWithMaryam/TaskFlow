<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme. Light/Dark ke colors values-night/colors.xml se khud aate hain -->
    <style name="Base.Theme.TaskFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tf_primary</item>
        <item name="colorOnPrimary">@color/tf_on_primary</item>
        <item name="colorSurface">@color/tf_surface</item>
        <item name="colorOnSurface">@color/tf_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/tf_on_surface_variant</item>
        <item name="colorOutline">@color/tf_surface_stroke</item>
        <item name="colorSecondaryContainer">@color/tf_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/tf_on_secondary_container</item>
        <item name="colorSurfaceContainerLow">@color/tf_surface</item>
        <item name="android:windowBackground">@color/tf_background</item>

        <!-- Dialogs ke buttons dark mode ma bhi saaf parhe jayen -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TaskFlow.Dialog</item>

        <!-- Inter: Material ke text sizes ke zariye (theme ka fontFamily nahi) -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TaskFlow.Inter.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TaskFlow.Inter.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.TaskFlow.Inter.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.TaskFlow.Inter.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.TaskFlow.Inter.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.TaskFlow.Inter.LabelSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TaskFlow.Inter.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.TaskFlow.Inter.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.TaskFlow.Inter.TitleSmall</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.TaskFlow.Inter.HeadlineSmall</item>
    </style>

    <style name="Theme.TaskFlow" parent="Base.Theme.TaskFlow" />

    <style name="ThemeOverlay.TaskFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/tf_dialog_accent</item>
    </style>

    <!-- App kholte waqt system ka splash: sirf teal background, icon nahi -->
    <style name="Theme.TaskFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tf_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.TaskFlow</item>
    </style>
</resources>