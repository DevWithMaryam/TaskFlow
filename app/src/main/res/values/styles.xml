<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shapes -->
    <style name="ShapeAppearance.TaskFlow.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TaskFlow.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.TaskFlow.HeaderTitle" parent="">
        <item name="android:fontFamily">@font/jersey_10_regular</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/tf_on_primary</item>
    </style>

    <style name="TextAppearance.TaskFlow.HeaderSubtitle" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tf_on_primary</item>
    </style>

    <style name="TextAppearance.TaskFlow.CardTitle" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tf_on_surface</item>
    </style>

    <style name="TextAppearance.TaskFlow.CardSubtitle" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tf_on_surface_variant</item>
    </style>

    <style name="TextAppearance.TaskFlow.Chip" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Teal header jiske neeche ki taraf curve hai -->
    <style name="Widget.TaskFlow.Header" parent="">
        <item name="android:background">@drawable/bg_header</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Card (Today, categories, settings rows) -->
    <style name="Widget.TaskFlow.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tf_surface</item>
        <item name="strokeColor">@color/tf_surface_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Priority chip (Low / Medium / High) -->
    <style name="Widget.TaskFlow.PriorityChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.TaskFlow.Chip</item>
        <item name="android:textColor">@color/tf_on_priority</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">@color/tf_on_priority</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="TextAppearance.TaskFlow.FilterLabel" parent="">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/tf_on_surface_variant</item>
    </style>

    <style name="Widget.TaskFlow.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/tf_surface</item>
    </style>

    <style name="Widget.TaskFlow.TextInputDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/tf_surface</item>
    </style>


    <!-- Inter, Material ke text sizes ke liye -->
    <style name="TextAppearance.TaskFlow.Inter.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.TaskFlow.Inter.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>
</resources>